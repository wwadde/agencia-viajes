# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Zona auth: 20 req/min → un humano rara vez pasa de 3-4 intentos de login seguidos
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;

# Zona API general: 120 req/min → 2 req/segundo, más que suficiente para uso normal
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=120r/m;

# Respeta el esquema/puerto original (ej: HTTPS en un proxy externo) y usa fallback local.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

map $http_x_forwarded_port $forwarded_port {
    default $http_x_forwarded_port;
    '' $server_port;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 5M;
    root /usr/share/nginx/html;
    index index.html;

    # Devuelve 429 Too Many Requests en lugar del genérico 503
    limit_req_status 429;

    location / {
        # En outputMode=server Angular genera index.csr.html (no index.html).
        # Si se evalúa $uri/ para '/', Nginx puede intentar listar directorio y responder 403.
        # Con este fallback, servimos archivos existentes y el resto lo resuelve SSR.
        try_files $uri @ssr;
    }

    location @ssr {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Auth: tolerante a ráfagas cortas (ej: doble-click accidental del usuario)
    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=auth_limit burst=5 nodelay;

        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Forwarded-Host $host;
    }

    # API general: muy permisivo, solo corta scraping/bots agresivos
    location /api/ {
        limit_req zone=api_limit burst=10 nodelay;

        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Endpoints OAuth2 de Spring Security (inicio y callback del proveedor)
    location /oauth2/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Port 443;
proxy_set_header X-Forwarded-Host $host;
    }

    location /login/oauth2/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Port 443;
proxy_set_header X-Forwarded-Host $host;
    }

    # Bloque dedicado a las imágenes físicas creadas por el panel Admin.
    # ^~ prioriza este prefijo sobre otras Regex, para servir directamente desde volumen.
    location ^~ /images/ {
        alias /usr/share/nginx/images/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Assets estáticos del propio build de Angular (JS, CSS, iconos)
    location ~* \.(js|css|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;
    gzip_min_length 1000;
}